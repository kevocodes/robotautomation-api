generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum CleaningTaskStatus {
  PENDING
  NOTIFIED
}

enum RoomDirection {
  LEFT
  RIGHT
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  email    String @unique
  name     String
  lastname String
  password String
  role     Role   @default(USER)

  emailVerified            Boolean   @default(false)
  emailVerificationOTP     String?
  emailVerificationExpires DateTime?

  resetPasswordToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Resource {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  externalResourceId String @unique

  name     String
  location String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  SelectedResource SelectedResource?

  @@map("resources")
}

model SelectedResource {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  resourceId String   @unique @db.ObjectId
  resource   Resource @relation(fields: [resourceId], references: [id])

  priority      Int
  roomDirection RoomDirection @default(LEFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("selected-resources")
}

// schema.prisma

model GlobalConfig {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  key String @unique @default("GLOBAL")

  cleaningStartOffsetMinutes           Int       @default(1)
  cleaningDurationMinutes              Int       @default(1)
  cleaningVerificationFrequencyMinutes Int       @default(60)
  cleaningLookAheadMinutes             Int       @default(120)
  lastCleaningVerificationAt           DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("global-configs")
}

model CleaningTask {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  eventId                    String             @unique
  resourceId                 String
  resourceName               String
  reservationReferenceNumber String
  startDate                  DateTime
  endDate                    DateTime
  color                      String
  textColor                  String
  status                     CleaningTaskStatus @default(PENDING)
  scheduledAt                DateTime           @default(now())
  notifiedAt                 DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cleaning-tasks")
}